JWT_SECRET=
DB_URL=jdbc:postgresql://localhost:5432/trading
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Admin seed account (only used on first boot against an empty DB)
ADMIN_SEED_PHONE=+910000000001
ADMIN_SEED_PASSWORD=ChangeMe@123
ADMIN_SEED_FIRST_NAME=Admin
ADMIN_SEED_LAST_NAME=User
ADMIN_SEED_EMAIL=

# Angel One market-data service integration
