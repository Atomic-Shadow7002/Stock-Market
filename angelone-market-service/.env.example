# Copy to .env and fill in — this is YOUR ONE AngelOne account, not per-user.
ANGEL_CLIENT_CODE=your_client_code
ANGEL_PIN=your_pin
# Base32 secret from AngelOne's authenticator setup (NOT a live 6-digit code —
# it's the static seed value, usually shown/downloadable when you first enable
# TOTP on the SmartAPI portal).
ANGEL_TOTP_SECRET=BASE32SECRETHERE
ANGEL_API_KEY=your_smartapi_key
ANGEL_LOCAL_IP=127.0.0.1
ANGEL_PUBLIC_IP=127.0.0.1
ANGEL_MAC_ADDRESS=AA:BB:CC:DD:EE:FF

# Shared secret your trading backend must send as X-Internal-Api-Key.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change-me-to-something-long-and-random

# Comma-separated origins allowed to open /ws/feed directly.
# Include your main backend (for server-side feed proxying) and your frontend origin.
FEED_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
